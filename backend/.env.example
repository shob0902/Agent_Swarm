DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=True

# Comma-separated list of hosts allowed to talk to the Django server.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Leave unset locally to use backend/db.sqlite3. In production point it at a
# free Postgres (Neon / Supabase), e.g. postgres://user:pass@host/db?sslmode=require
# DATABASE_URL=

# --- Pipeline executor ------------------------------------------------------
# "local"          -> runs `manage.py run_agent_task` as a detached subprocess on this
#                     machine (development; needs Docker Desktop for the sandbox).
# "github_actions" -> Django only creates the task and fires a workflow_dispatch on
#                     GITHUB_ACTIONS_REPO; the agents run on a GitHub-hosted runner.
PIPELINE_EXECUTOR=local

# Only used when PIPELINE_EXECUTOR=github_actions -------------------------------
# The repo that contains .github/workflows/agent-swarm.yml (this project), "owner/name".
GITHUB_ACTIONS_REPO=
GITHUB_ACTIONS_WORKFLOW=agent-swarm.yml
GITHUB_ACTIONS_REF=main
# Fine-grained PAT, access to GITHUB_ACTIONS_REPO only, permission "Actions: Read and write".
# Stays in the web process; never reaches the browser or the runner.
GITHUB_DISPATCH_TOKEN=
# Random string shared with the runner (also set as the RUNNER_SHARED_SECRET Actions secret).
# The runner signs its status callbacks with it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUNNER_SHARED_SECRET=
# Public URL of this API as the runner sees it (only the runner uses this).
AGENT_SWARM_API_URL=http://localhost:8000/api

# --- Pull requests ----------------------------------------------------------------
# Token the *runner* uses to push a branch and open the PR on the target repository.
# Fine-grained PAT on the target repos: "Contents: Read and write" + "Pull requests: Read and write".
# With the local executor it is read from here; with GitHub Actions, from the Actions secret.
AGENT_GITHUB_TOKEN=
# Set to False to stop after the Reviewer (old behaviour: validated diff, no PR).
CREATE_PULL_REQUESTS=True
# When the token cannot write to the target repo: fork it into the token's account, push the
# branch there and open a cross-repo PR to upstream. On a public deployment, pair this with
# ALLOWED_REPO_OWNERS so the bot can't be used to open PRs on arbitrary repositories.
PR_ALLOW_FORKS=True
# Optional allow-list of repo owners tasks may target (comma-separated). Empty = any public repo.
ALLOWED_REPO_OWNERS=
PR_BRANCH_PREFIX=agent-swarm
PR_LABELS=agent-swarm,automated-pr
# Look the repository up on GitHub when a task is created (rejects typos/private/archived early).
GITHUB_VALIDATE_REPOS=True

# --- LLM API keys: four Groq keys, one dedicated key per agent role --------
# All four come from https://console.groq.com/keys. Planner and Reviewer
# each get a single key. The Coder is the highest-volume agent (one call
# per plan, plus one per retry attempt) and gets two, which it rotates
# between least-recently-used-first with a per-key cooldown on 429s -- see
# backend/agents/services/key_pool.py for the exact algorithm. The Tester
# uses no LLM at all (it runs the repo's real checks in the sandbox),
# so it needs no key.
GROQ_API_KEY_PLANNER=
GROQ_API_KEY_CODER_A=
GROQ_API_KEY_CODER_B=
GROQ_API_KEY_REVIEWER=
# llama-3.1-8b-instant has been retired from Groq. gpt-oss-120b is free-tier and reasons
# before answering; keep the effort "low" so reasoning doesn't eat the agents' output budgets.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# --- Retry limits -------------------------------------------------------------------
# Coder -> Tester attempts per review cycle, and extra cycles after a Reviewer rejection.
# Worst case Coder calls per task = MAX_TEST_RETRIES * (MAX_REVIEW_RETRIES + 1).
MAX_TEST_RETRIES=3
MAX_REVIEW_RETRIES=1

# --- Sandbox (Tester) ------------------------------------------------------------------
SANDBOX_IMAGE=agent-swarm-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_INSTALL_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=1g
# Dependency install is the only sandbox step with network access (and it gets no secrets).
SANDBOX_INSTALL_DEPENDENCIES=True

# --- OAuth (Google / GitHub sign-in) ---------------------------------------
# Frontend origin used to build the OAuth callback URLs below and other
# absolute links (e.g. password reset). Change if the Vite dev server isn't
# on its default port.
FRONTEND_BASE_URL=http://localhost:5173
#
# Google: https://console.cloud.google.com/apis/credentials -> Create
# Credentials -> OAuth client ID -> Web application. Add this as an
# Authorized redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers -> New OAuth App.
# Authorization callback URL: http://localhost:5173/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# A provider's "Continue with ..." button is enabled only once both its CLIENT_ID and
# CLIENT_SECRET are set here -- the frontend reads the public IDs from
# GET /api/auth/providers/, so nothing goes in frontend/.env. Every origin in
# FRONTEND_BASE_URL / CORS_ALLOWED_ORIGINS is an accepted callback origin; register
# <origin>/auth/callback/<provider> with Google/GitHub for each one you use.
# Email/password signup works regardless.

# Comma-separated list of origins the React dev server (Vite) may call the API from.
# Vite bumps to 5174/5175 if 5173 is already taken (e.g. a leftover `npm run dev`
# from a previous session) -- those fallback ports are allow-listed too so a
# stray process doesn't turn into a silent CORS failure on task creation.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Production only: the frontend origin(s), for Django's CSRF checks on cross-site requests.
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
