DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=True
REDIS_URL=redis://localhost:6379/0

# --- LLM API keys: four Groq keys, one dedicated key per agent role --------
# All four come from https://console.groq.com/keys. Planner and Reviewer
# each get a single key. The Coder is the highest-volume agent (one call
# per plan, plus one per retry attempt) and gets two, which it rotates
# between least-recently-used-first with a per-key cooldown on 429s -- see
# backend/agents/services/key_pool.py for the exact algorithm. The Tester
# uses no LLM at all (it runs the repo's real test suite in the sandbox),
# so it needs no key.
GROQ_API_KEY_PLANNER=
GROQ_API_KEY_CODER_A=
GROQ_API_KEY_CODER_B=
GROQ_API_KEY_REVIEWER=

# --- OAuth (Google / GitHub sign-in) ---------------------------------------
# Frontend origin used to build the OAuth callback URLs below and other
# absolute links (e.g. password reset). Change if the Vite dev server isn't
# on its default port.
FRONTEND_BASE_URL=http://localhost:5173
#
# Google: https://console.cloud.google.com/apis/credentials -> Create
# Credentials -> OAuth client ID -> Web application. Add this as an
# Authorized redirect URI: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers -> New OAuth App.
# Authorization callback URL: http://localhost:5173/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Until both CLIENT_ID/CLIENT_SECRET pairs above are filled in, the
# "Continue with Google/GitHub" buttons render disabled in the UI --
# email/password signup works regardless.

# Comma-separated list of hosts allowed to talk to the Django dev server.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins the React dev server (Vite) may call the API from.
# Vite bumps to 5174/5175 if 5173 is already taken (e.g. a leftover `npm run dev`
# from a previous session) -- those fallback ports are allow-listed too so a
# stray process doesn't turn into a silent CORS failure on task creation.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
